# Copy to .env.local and fill in. .env.local is gitignored.

# --- Existing integrations ---
# Resend (contact form + hire notification email)
RESEND_API_KEY=
# GitHub token (raises API rate limit for repo/activity widgets)
GITHUB_TOKEN=
# PostHog analytics (public, safe to expose)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- devOS Concierge (Ask devOS) ---
# Required for the AI concierge. Without it, /api/concierge returns 503 and the
# Spotlight "Ask devOS" panel shows a graceful offline fallback.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6 (see app/api/concierge/route.ts).
CONCIERGE_MODEL=
# Optional. Makes the per-IP rate limit and daily spend ceiling survive cold
# starts (Upstash free tier). Without them, or if Upstash is unreachable, an
# in-memory limiter enforces the same caps per serverless instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
