# Copy to .env.local and fill in. .env.local is gitignored.

# --- Existing integrations ---
# Resend (contact form + hire notification email)
RESEND_API_KEY=
# GitHub token (raises API rate limit for repo/activity widgets)
GITHUB_TOKEN=
# PostHog analytics (public, safe to expose)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- devOS Concierge (Ask devOS) ---
# Required for the AI concierge. Without it, /api/concierge returns 503 and the
# Spotlight "Ask devOS" panel shows a graceful offline fallback.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6 (see app/api/concierge/route.ts).
CONCIERGE_MODEL=
# Optional. Makes the per-IP rate limit and daily spend ceiling survive cold
# starts (Upstash free tier). Without them, or if Upstash is unreachable, an
# in-memory limiter enforces the same caps per serverless instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Arcade leaderboard (/api/arcade/*) ---
# Signs run tokens. Optional: without it the secret is derived from
# UPSTASH_REDIS_REST_TOKEN, and local dev uses a fixed string.
ARCADE_TOKEN_SECRET=
# Bearer token for DELETE /api/arcade/admin. Unset turns that route off (404).
ARCADE_ADMIN_TOKEN=
# Typing this as a name posts the score under ARCADE_HER_NAME with a crown.
ARCADE_CROWN_CODE=
ARCADE_HER_NAME=
# Served by GET /api/arcade/secret together with ARCADE_HER_NAME.
ARCADE_SECRET_MESSAGE=
